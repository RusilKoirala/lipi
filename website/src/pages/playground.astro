---
import Base from "@/layouts/Base.astro";
import Playground from "@/components/lipi/Playground";
---

<Base
  title="Playground"
  description="Write and run Lipi in your browser. The real Go interpreter, compiled to WebAssembly."
  footer={false}
  app
>
  <div class="mx-auto flex h-full w-full max-w-[90rem] flex-col gap-3 px-3 pt-3 pb-[max(0.75rem,env(safe-area-inset-bottom))] sm:px-6 sm:pt-5">
    <div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1 px-1">
      <h1 class="text-lg font-semibold tracking-tight">Playground</h1>
      <p class="text-sm text-muted-foreground">
        Your code is saved in this browser. Share makes a link with the code inside it.
      </p>
    </div>
    <div class="min-h-0 flex-1">
      <Playground client:load />
    </div>
  </div>
</Base>
