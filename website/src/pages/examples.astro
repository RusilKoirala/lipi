---
import Base from "@/layouts/Base.astro";
import LipiCode from "@/components/LipiCode.astro";
import { EXAMPLES } from "@/lib/examples";
import { href } from "@/lib/site";
---

<Base title="Examples" description="Small Lipi programs: recursion, closures, Devanagari strings and a deliberate Galti.">
  <div class="mx-auto w-full max-w-6xl px-4 pt-14 pb-24 sm:px-6">
    <p class="eyebrow"><span class="ne" lang="ne">उदाहरण</span> · Examples</p>
    <h1 class="shiro mt-4 text-4xl font-semibold tracking-tight">Programs to read and run</h1>
    <p class="mt-4 max-w-2xl text-muted-foreground">
      Each one fits on a screen. Open any of them in the playground to change it and see what happens.
    </p>

    <div class="mt-14 grid grid-cols-1 gap-x-10 gap-y-16 lg:grid-cols-2">
      {
        EXAMPLES.map((ex) => (
          <article id={ex.id} class="flex min-w-0 scroll-mt-24 flex-col">
            <header class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
              <h2 class="text-xl font-semibold tracking-tight">{ex.title}</h2>
              <span class="font-deva-text text-muted-foreground" lang="ne">
                {ex.ne}
              </span>
              <span class="ml-auto font-mono text-xs text-muted-foreground">{ex.file}</span>
            </header>
            <p class="mt-2 text-[15px] text-muted-foreground">{ex.description}</p>

            <div class="mt-4 flex min-h-0 flex-1 flex-col overflow-hidden rounded-xl border bg-card">
              <LipiCode code={ex.code} class="flex-1 px-4 py-3.5" />
              <div class="border-t bg-paper px-4 py-3 font-mono text-[13px] leading-6">
                <p class="mb-1 font-sans text-[11px] font-medium tracking-[0.08em] text-muted-foreground uppercase">
                  Output
                </p>
                {ex.output.split("\n").map((line) =>
                  line.startsWith("Galti") ? (
                    <p class="text-crimson">{line}</p>
                  ) : (
                    <p class="whitespace-pre-wrap"><span class="mr-2 text-muted-foreground/60 select-none">›</span>{line}</p>
                  ),
                )}
              </div>
            </div>

            <a
              href={href(`/playground#example=${ex.id}`)}
              class="mt-3 inline-flex w-fit items-center gap-1.5 text-sm font-medium underline decoration-crimson decoration-[1.5px] underline-offset-4 hover:text-crimson"
            >
              Open in the playground
            </a>
          </article>
        ))
      }
    </div>
  </div>
</Base>
