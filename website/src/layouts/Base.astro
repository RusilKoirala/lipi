---
import "@/styles/global.css";
import Nav from "@/components/Nav.astro";
import Footer from "@/components/Footer.astro";
import { href } from "@/lib/site";
import Analytics from "@vercel/analytics/astro";
import SpeedInsights from "@vercel/speed-insights/astro";

interface Props {
  title?: string;
  description?: string;
  footer?: boolean;
  /** Full-height app layout (playground). */
  app?: boolean;
}

const {
  title,
  description = "Lipi is a small programming language you write with Nepali words. Try it in your browser, install it in one command.",
  footer = true,
  app = false,
} = Astro.props;

const fullTitle = title ? `${title} · Lipi` : "Lipi";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta name="theme-color" content="#fdfcfc" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#14161f" media="(prefers-color-scheme: dark)" />
    <link rel="icon" type="image/svg+xml" href={href("/favicon.svg")} />
    <script is:inline>
      // Apply the saved or system theme before the page paints.
      (() => {
        let saved = null;
        try {
          saved = localStorage.getItem("theme");
        } catch {}
        const dark = saved ? saved === "dark" : matchMedia("(prefers-color-scheme: dark)").matches;
        document.documentElement.classList.toggle("dark", dark);
      })();
    </script>
    <Analytics />
    <SpeedInsights />
  </head>
  <body class:list={["flex flex-col", app ? "h-dvh overflow-hidden" : "min-h-dvh"]}>
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-50 focus:rounded-md focus:bg-background focus:px-3 focus:py-2 focus:shadow"
      >Skip to content</a
    >
    <Nav />
    <main id="main" class:list={["flex-1", app && "min-h-0"]}>
      <slot />
    </main>
    {footer && <Footer />}

    <script>
      // Copy buttons: any element with data-copy="text".
      document.addEventListener("click", async (e) => {
        const btn = (e.target as HTMLElement).closest<HTMLElement>("[data-copy]");
        if (!btn) return;
        try {
          await navigator.clipboard.writeText(btn.dataset.copy ?? "");
        } catch {
          return;
        }
        btn.dataset.copied = "true";
        const label = btn.querySelector<HTMLElement>("[data-copy-label]");
        const before = label?.textContent;
        if (label) label.textContent = "Copied";
        setTimeout(() => {
          delete btn.dataset.copied;
          if (label && before) label.textContent = before;
        }, 1600);
      });
    </script>
  </body>
</html>
