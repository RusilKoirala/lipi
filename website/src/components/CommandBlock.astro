---
interface Props {
  cmd: string;
  /** Shown before the command, e.g. "$". */
  prompt?: string;
  class?: string;
}
const { cmd, prompt = "$", class: className } = Astro.props;
---

<div
  class:list={[
    "group flex max-w-full min-w-0 items-center gap-3 rounded-lg border bg-paper py-1.5 pr-1.5 pl-3.5 font-mono text-[13px]",
    className,
  ]}
>
  <span class="text-crimson select-none" aria-hidden="true">{prompt}</span>
  <code class="min-w-0 flex-1 overflow-x-auto whitespace-nowrap">{cmd}</code>
  <button
    type="button"
    data-copy={cmd}
    class="inline-flex h-7 shrink-0 items-center gap-1.5 rounded-md px-2 font-sans text-xs text-muted-foreground transition-colors hover:bg-muted hover:text-foreground data-[copied]:text-emerald-600 dark:data-[copied]:text-emerald-400"
    aria-label={`Copy: ${cmd}`}
  >
    <svg class="size-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="14" height="14" x="8" y="8" rx="2"></rect><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"></path></svg>
    <span data-copy-label>Copy</span>
  </button>
</div>
